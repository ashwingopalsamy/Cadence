<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>in.ashwingopalsamy.cadence.agent</string>
  <key>BundleProgram</key>
  <string>Contents/Helpers/cadence</string>
  <key>ProgramArguments</key>
  <array>
    <string>cadence</string>
    <string>collect</string>
    <string>run</string>
    <string>--due</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>WatchPaths</key>
  <array>
    <string>@JOBS_PATH@</string>
  </array>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
